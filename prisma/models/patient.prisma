model Patient {
    id           String        @id @default(uuid())
    name         String
    email        String        @unique
    phone        String        @unique
    password     String
    document     String        @unique
    address      String
    birthDate    DateTime?
    avatarUrl    String?       @db.Text
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    appointments Appointment[]
    attachments  Attachment[]
    payments     Payment[]

    @@map("patients")
}
